# Optional: set this when switching local development to PostgreSQL or for hosting.
# DATABASE_URL=postgresql://buyfarm:buyfarm_dev@localhost:5432/buyfarm
NODE_ENV=development
PORT=4173
DATABASE_SSL=false

# Owner dashboard access is granted only when the signed-in account email and
# this private access key both match. Generate a 32-byte key with:
# node -p "require('node:crypto').randomBytes(32).toString('base64url')"
BUYFARM_ADMIN_EMAIL=owner@example.com
BUYFARM_ADMIN_KEY=

# Optional order email alerts. Set RESEND_FROM_EMAIL to a sender you have
# verified with Resend; keep the API key private in .env / Vercel settings.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

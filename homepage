<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BuyFarm | Home</title>
  <link rel="stylesheet" href="css/buyfarm.css">
</head>
<body>
  <header class="site-header">
    <div class="container nav">
      <a class="brand" href="index.html"><img src="assets/logo.svg" alt="BuyFarm"><span>BuyFarm</span></a>
      <nav class="main-nav"><a class="active" href="index.html">Home</a><a href="products.html">Products</a><a href="buyonline.html">Order</a><a href="contactus.html">Contact</a></nav>
      <div class="nav-actions"><button class="nav-button" id="cartButton" type="button">Cart <span class="count" id="cartCount">0</span></button><a class="nav-button primary" href="login page">Sign in</a></div>
    </div>
  </header>
  <main>
    <section class="hero"><div class="container hero-grid"><div><span class="eyebrow">Harvested locally</span><h1>Fresh from the farm,<br>delivered to you.</h1><p>Seasonal vegetables, fruits, grains and pantry essentials from trusted local farms.</p><div class="hero-actions"><a class="button primary" href="products.html">Shop fresh</a><a class="button secondary" href="buyonline.html">Place an order</a></div></div><div class="hero-art" aria-hidden="true"><div class="basket"><div class="produce one"></div><div class="produce two"></div><div class="produce three"></div></div></div></div></section>
    <section class="container trust-strip"><article><strong>100% fresh</strong><span>Peak quality produce</span></article><article><strong>Local farms</strong><span>Direct from growers</span></article><article><strong>Fast delivery</strong><span>24-48 hour delivery</span></article><article><strong>Secure checkout</strong><span>Simple ordering</span></article></section>
    <section class="container section"><div class="section-heading"><div><span class="eyebrow">Popular this week</span><h2>Farm favorites</h2></div><a class="text-link" href="products.html">View all products →</a></div><div class="product-grid" id="featuredProducts"></div></section>
  </main>
  <aside class="drawer-backdrop" id="cartBackdrop" hidden><div class="drawer"><div class="drawer-header"><h2>Your cart</h2><button class="close-button" type="button" data-close-cart>×</button></div><div class="cart-items" id="cartItems"></div><div class="cart-footer"><div class="cart-total"><span>Total</span><strong id="cartTotal">₹0</strong></div><button class="button primary full" id="checkoutButton" type="button">Continue to checkout</button></div></div></aside>
  <div id="buyfarm-toast" class="toast" role="status"></div>
  <script src="app.js"></script>
</body>
</html>
